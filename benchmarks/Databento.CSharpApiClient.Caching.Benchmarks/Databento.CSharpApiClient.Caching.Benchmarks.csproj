<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Databento.CSharpApiClient.Caching.Benchmarks</RootNamespace>
    <AssemblyName>Databento.CSharpApiClient.Caching.Benchmarks</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Databento.CSharpApiClient.Caching\Databento.CSharpApiClient.Caching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="benchmark.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="benchmark-mini.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
